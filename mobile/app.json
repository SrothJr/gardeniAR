{
  "expo": {
    "name": "GardeniAR",
    "slug": "gardeniar-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/gardeniAR_icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071024",
        "foregroundImage": "./assets/icons/gardeniAR_icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tarif420.gardeniAR"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/gardeniAR_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/gardeniAR_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ffccb22e-6fcc-419e-bb75-e6c97d88f326"
      }
    }
  }
}
